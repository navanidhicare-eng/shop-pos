# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
APP_PORT=5000

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_TYPE=postgres

# Default when running with Docker Compose:
# Use "postgres" to connect to the docker postgres service.
# If PostgreSQL is downloaded and installed directly on your Homeserver OS, use:
# DB_HOST=host.docker.internal
DB_HOST=postgres

DB_PORT=5432
DB_PORT_HOST=5432
DB_NAME=shop_db
DB_USER=postgres
DB_PASSWORD=shop_secure_password_123

# Set to true if connecting to remote cloud PostgreSQL with SSL
DB_SSL=false
